# justfile for lfx-rag (Python) — uv-based

default: test

install:
    uv sync --all-extras --dev

lint:
    uv run ruff check .

format:
    uv run ruff format .

typecheck:
    uv run pyright src

test:
    uv run pytest -q

cov:
    uv run pytest --cov=src --cov-report=term-missing -q

run-cli:
    uv run lfx-rag --help

serve-api:
    uv run uvicorn lfx_rag.api:app --reload

check:
    uv run ruff check .
    uv run ruff format --check .
    uv run pyright src
    uv run pytest -q
