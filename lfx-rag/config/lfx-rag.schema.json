{
  "$defs": {
    "ChunkingConfig": {
      "properties": {
        "default_strategy": {
          "default": "sliding_window",
          "description": "Active chunking strategy",
          "enum": [
            "sliding_window",
            "semantic"
          ],
          "title": "Default Strategy",
          "type": "string"
        },
        "semantic": {
          "$ref": "#/$defs/SemanticChunking",
          "default": {
            "enabled": false,
            "min_chunk_size": 100,
            "threshold": 0.85
          }
        },
        "sliding_window": {
          "$ref": "#/$defs/SlidingWindowChunking",
          "default": {
            "chunk_size": 512,
            "overlap": 128,
            "unit": "tokens"
          }
        }
      },
      "title": "ChunkingConfig",
      "type": "object"
    },
    "CloudEmbeddings": {
      "properties": {
        "enabled": {
          "default": false,
          "description": "Enable cloud embeddings via API",
          "title": "Enabled",
          "type": "boolean"
        },
        "model": {
          "default": "text-embedding-004",
          "description": "Cloud embedding model name",
          "title": "Model",
          "type": "string"
        },
        "provider": {
          "const": "google",
          "default": "google",
          "description": "Cloud embeddings provider",
          "title": "Provider",
          "type": "string"
        }
      },
      "title": "CloudEmbeddings",
      "type": "object"
    },
    "CloudGeneration": {
      "properties": {
        "enabled": {
          "default": false,
          "description": "Enable cloud generation via API",
          "title": "Enabled",
          "type": "boolean"
        },
        "max_tokens": {
          "default": 4096,
          "description": "Maximum generation tokens",
          "minimum": 1,
          "title": "Max Tokens",
          "type": "integer"
        },
        "model": {
          "default": "llama-3.3-70b-versatile",
          "description": "Cloud LLM model name",
          "title": "Model",
          "type": "string"
        },
        "provider": {
          "const": "groq",
          "default": "groq",
          "description": "Cloud LLM provider",
          "title": "Provider",
          "type": "string"
        },
        "temperature": {
          "default": 0.2,
          "description": "LLM temperature",
          "maximum": 2.0,
          "minimum": 0.0,
          "title": "Temperature",
          "type": "number"
        }
      },
      "title": "CloudGeneration",
      "type": "object"
    },
    "DocumentSourceConfig": {
      "properties": {
        "library_dir": {
          "default": "~/Biblioteca",
          "description": "Library directory (used as fallback if manifest unavailable)",
          "format": "path",
          "title": "Library Dir",
          "type": "string"
        },
        "manifest_path": {
          "default": "~/.local/share/lfx/manifest.db",
          "description": "Path to lfx manifest SQLite database",
          "format": "path",
          "title": "Manifest Path",
          "type": "string"
        }
      },
      "title": "DocumentSourceConfig",
      "type": "object"
    },
    "EmbeddingsConfig": {
      "properties": {
        "cloud": {
          "$ref": "#/$defs/CloudEmbeddings",
          "default": {
            "enabled": false,
            "model": "text-embedding-004",
            "provider": "google"
          }
        },
        "local": {
          "$ref": "#/$defs/LocalEmbeddings",
          "default": {
            "batch_size": 32,
            "device": "auto",
            "dimension": 384,
            "model": "intfloat/multilingual-e5-small"
          }
        }
      },
      "title": "EmbeddingsConfig",
      "type": "object"
    },
    "FormatsConfig": {
      "properties": {
        "epub": {
          "default": true,
          "description": "Process EPUB files",
          "title": "Epub",
          "type": "boolean"
        },
        "pdf": {
          "default": true,
          "description": "Process PDF files",
          "title": "Pdf",
          "type": "boolean"
        }
      },
      "title": "FormatsConfig",
      "type": "object"
    },
    "GenerationConfig": {
      "properties": {
        "cloud": {
          "$ref": "#/$defs/CloudGeneration",
          "default": {
            "enabled": false,
            "max_tokens": 4096,
            "model": "llama-3.3-70b-versatile",
            "provider": "groq",
            "temperature": 0.2
          }
        },
        "default": {
          "default": "local",
          "description": "Active generation provider",
          "enum": [
            "local",
            "cloud"
          ],
          "title": "Default",
          "type": "string"
        },
        "local": {
          "$ref": "#/$defs/LocalGeneration",
          "default": {
            "base_url": "http://localhost:11434",
            "max_tokens": 2048,
            "model": "qwen3:8b",
            "provider": "ollama",
            "temperature": 0.2
          }
        }
      },
      "title": "GenerationConfig",
      "type": "object"
    },
    "LocalEmbeddings": {
      "properties": {
        "batch_size": {
          "default": 32,
          "description": "Batch size for embedding generation",
          "minimum": 1,
          "title": "Batch Size",
          "type": "integer"
        },
        "device": {
          "default": "auto",
          "description": "Compute device (auto detects mps > cuda > cpu)",
          "enum": [
            "auto",
            "cpu",
            "mps",
            "cuda"
          ],
          "title": "Device",
          "type": "string"
        },
        "dimension": {
          "default": 384,
          "description": "Embedding vector dimension",
          "minimum": 1,
          "title": "Dimension",
          "type": "integer"
        },
        "model": {
          "default": "intfloat/multilingual-e5-small",
          "description": "Sentence-transformers model identifier",
          "title": "Model",
          "type": "string"
        }
      },
      "title": "LocalEmbeddings",
      "type": "object"
    },
    "LocalGeneration": {
      "properties": {
        "base_url": {
          "default": "http://localhost:11434",
          "description": "Ollama server base URL",
          "title": "Base Url",
          "type": "string"
        },
        "max_tokens": {
          "default": 2048,
          "description": "Maximum generation tokens",
          "minimum": 1,
          "title": "Max Tokens",
          "type": "integer"
        },
        "model": {
          "default": "qwen3:8b",
          "description": "Local LLM model name",
          "title": "Model",
          "type": "string"
        },
        "provider": {
          "const": "ollama",
          "default": "ollama",
          "description": "Local LLM provider",
          "title": "Provider",
          "type": "string"
        },
        "temperature": {
          "default": 0.2,
          "description": "LLM temperature",
          "maximum": 2.0,
          "minimum": 0.0,
          "title": "Temperature",
          "type": "number"
        }
      },
      "title": "LocalGeneration",
      "type": "object"
    },
    "MLflowConfig": {
      "properties": {
        "enabled": {
          "default": false,
          "description": "Enable MLflow experiment tracking",
          "title": "Enabled",
          "type": "boolean"
        },
        "experiment_name": {
          "default": "lfx-rag",
          "description": "MLflow experiment name",
          "title": "Experiment Name",
          "type": "string"
        },
        "tracking_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "MLflow tracking URI (default: local mlruns/)",
          "title": "Tracking Uri"
        }
      },
      "title": "MLflowConfig",
      "type": "object"
    },
    "MonitoringConfig": {
      "properties": {
        "mlflow": {
          "$ref": "#/$defs/MLflowConfig",
          "default": {
            "enabled": false,
            "experiment_name": "lfx-rag",
            "tracking_uri": null
          }
        }
      },
      "title": "MonitoringConfig",
      "type": "object"
    },
    "PipelineConfig": {
      "properties": {
        "batch_size": {
          "default": 10,
          "description": "Documents per batch",
          "minimum": 1,
          "title": "Batch Size",
          "type": "integer"
        },
        "max_concurrent": {
          "default": 4,
          "description": "Max parallel workers",
          "minimum": 1,
          "title": "Max Concurrent",
          "type": "integer"
        }
      },
      "title": "PipelineConfig",
      "type": "object"
    },
    "RerankerConfig": {
      "properties": {
        "enabled": {
          "default": false,
          "description": "Enable cross-encoder reranker",
          "title": "Enabled",
          "type": "boolean"
        },
        "model": {
          "default": "bge-reranker-v2-m3",
          "description": "Reranker model identifier",
          "title": "Model",
          "type": "string"
        },
        "top_k": {
          "default": 5,
          "description": "Number of results after reranking",
          "minimum": 1,
          "title": "Top K",
          "type": "integer"
        }
      },
      "title": "RerankerConfig",
      "type": "object"
    },
    "SemanticChunking": {
      "properties": {
        "enabled": {
          "default": false,
          "description": "Enable semantic chunking (experimental)",
          "title": "Enabled",
          "type": "boolean"
        },
        "min_chunk_size": {
          "default": 100,
          "description": "Minimum chunk size in tokens",
          "minimum": 1,
          "title": "Min Chunk Size",
          "type": "integer"
        },
        "threshold": {
          "default": 0.85,
          "description": "Similarity threshold for splitting",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Threshold",
          "type": "number"
        }
      },
      "title": "SemanticChunking",
      "type": "object"
    },
    "SlidingWindowChunking": {
      "properties": {
        "chunk_size": {
          "default": 512,
          "description": "Number of tokens per chunk",
          "minimum": 1,
          "title": "Chunk Size",
          "type": "integer"
        },
        "overlap": {
          "default": 128,
          "description": "Overlap between consecutive chunks",
          "minimum": 0,
          "title": "Overlap",
          "type": "integer"
        },
        "unit": {
          "default": "tokens",
          "description": "Unit for chunk_size",
          "enum": [
            "tokens",
            "chars"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "title": "SlidingWindowChunking",
      "type": "object"
    },
    "StateConfig": {
      "properties": {
        "db_path": {
          "default": "~/.local/share/lfx-rag/state.db",
          "description": "Path to SQLite tracking database",
          "format": "path",
          "title": "Db Path",
          "type": "string"
        }
      },
      "title": "StateConfig",
      "type": "object"
    },
    "VectorStoreConfig": {
      "properties": {
        "create_if_missing": {
          "default": true,
          "description": "Create the table if it doesn't exist",
          "title": "Create If Missing",
          "type": "boolean"
        },
        "search_limit": {
          "default": 20,
          "description": "Default top-k for vector search",
          "maximum": 200,
          "minimum": 1,
          "title": "Search Limit",
          "type": "integer"
        },
        "search_metric": {
          "default": "cosine",
          "description": "Distance metric for vector similarity search",
          "enum": [
            "cosine",
            "l2",
            "dot"
          ],
          "title": "Search Metric",
          "type": "string"
        },
        "table": {
          "default": "documents",
          "description": "LanceDB table name",
          "title": "Table",
          "type": "string"
        },
        "uri": {
          "default": "~/.local/share/lfx-rag/lancedb",
          "description": "LanceDB database URI",
          "format": "path",
          "title": "Uri",
          "type": "string"
        }
      },
      "title": "VectorStoreConfig",
      "type": "object"
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "JSON Schema for lfx-rag YAML configuration files",
  "properties": {
    "chunking": {
      "$ref": "#/$defs/ChunkingConfig",
      "default": {
        "default_strategy": "sliding_window",
        "semantic": {
          "enabled": false,
          "min_chunk_size": 100,
          "threshold": 0.85
        },
        "sliding_window": {
          "chunk_size": 512,
          "overlap": 128,
          "unit": "tokens"
        }
      }
    },
    "document_source": {
      "$ref": "#/$defs/DocumentSourceConfig",
      "default": {
        "library_dir": "~/Biblioteca",
        "manifest_path": "~/.local/share/lfx/manifest.db"
      }
    },
    "embeddings": {
      "$ref": "#/$defs/EmbeddingsConfig",
      "default": {
        "cloud": {
          "enabled": false,
          "model": "text-embedding-004",
          "provider": "google"
        },
        "local": {
          "batch_size": 32,
          "device": "auto",
          "dimension": 384,
          "model": "intfloat/multilingual-e5-small"
        }
      }
    },
    "formats": {
      "$ref": "#/$defs/FormatsConfig",
      "default": {
        "epub": true,
        "pdf": true
      }
    },
    "generation": {
      "$ref": "#/$defs/GenerationConfig",
      "default": {
        "cloud": {
          "enabled": false,
          "max_tokens": 4096,
          "model": "llama-3.3-70b-versatile",
          "provider": "groq",
          "temperature": 0.2
        },
        "default": "local",
        "local": {
          "base_url": "http://localhost:11434",
          "max_tokens": 2048,
          "model": "qwen3:8b",
          "provider": "ollama",
          "temperature": 0.2
        }
      }
    },
    "monitoring": {
      "$ref": "#/$defs/MonitoringConfig",
      "default": {
        "mlflow": {
          "enabled": false,
          "experiment_name": "lfx-rag",
          "tracking_uri": null
        }
      }
    },
    "pipeline": {
      "$ref": "#/$defs/PipelineConfig",
      "default": {
        "batch_size": 10,
        "max_concurrent": 4
      }
    },
    "reranker": {
      "$ref": "#/$defs/RerankerConfig",
      "default": {
        "enabled": false,
        "model": "bge-reranker-v2-m3",
        "top_k": 5
      }
    },
    "state": {
      "$ref": "#/$defs/StateConfig",
      "default": {
        "db_path": "~/.local/share/lfx-rag/state.db"
      }
    },
    "vector_store": {
      "$ref": "#/$defs/VectorStoreConfig",
      "default": {
        "create_if_missing": true,
        "search_limit": 20,
        "search_metric": "cosine",
        "table": "documents",
        "uri": "~/.local/share/lfx-rag/lancedb"
      }
    }
  },
  "title": "lfx-rag Configuration",
  "type": "object"
}
